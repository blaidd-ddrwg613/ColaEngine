<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Gum.Expressions" Version="2026.9.2.1" />
      <PackageReference Include="Raylib-cs" Version="8.1.0" />
    </ItemGroup>
    <ItemGroup>
        <None Include="resources\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\ColaEngine\ColaEngine.csproj" />
    </ItemGroup>
    <ItemGroup>
      <Folder Include="resources\GumProject\" />
    </ItemGroup>
    <ItemGroup>
        <None Update="resources\GumProject\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
